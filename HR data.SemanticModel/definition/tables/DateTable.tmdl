	partition DateTable = calculated
		mode: import
		source = ```
				
				VAR MinDate = DATE(2010, 1, 1)  -- Adjust to your dataset's minimum date
				VAR MaxDate = DATE(2025, 12, 31) -- Adjust to your dataset's maximum date
				
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				    "Week", WEEKNUM([Date]),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MM"),  -- Ensure two-digit month format
				    "MonthName", FORMAT([Date], "MMMM"), 
				    "YearMonth", FORMAT([Date], "YYYYMM"),  -- Year and Month in YYYYMM format
				    "YearMonthName", FORMAT([Date], "MMMM - YYYY"),  -- Full Month and Year
				    "Day", DAY([Date]),
				    "Quarter", "Q" & FORMAT(CEILING(MONTH([Date]) / 3, 1), "0"),
				    "WeekYear", FORMAT(WEEKNUM([Date]), "00") & "-" & FORMAT(YEAR([Date]), "0000"),  -- Correct week and year format
				    "WeekDay", FORMAT([Date], "dddd")
				)
				
				```

	annotation PBI_Id = 701b7eb0b5fa473586d6e34351a4cbb3


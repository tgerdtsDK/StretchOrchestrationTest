table SALARY
	lineageTag: f30685a5-cd3f-4200-8a4d-196fa5f13f07

	measure 'Total Emp Expense' = ```
			
			SUMX(
			    'Employees',
			    CALCULATE(
			        SUM(Salary[BaseSalary]) + SUM(Salary[Bonus]),
			        YEAR(Salary[EffectiveDate]) IN VALUES('DateTable'[Year])
			    )
			)
			
			```
		lineageTag: 0344a970-90f5-4c16-84fd-05a30f5ce913

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Base Salary Per Employee' = ```
			
			AVERAGEX(
			    VALUES('Employees'[EmployeeID]),
			    CALCULATE(
			        AVERAGE(Salary[BaseSalary]),
			        YEAR(Salary[EffectiveDate]) IN VALUES('DateTable'[Year])
			    )
			)
			
			```
		lineageTag: 07c68064-09b8-4fef-b782-c4318a768508

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Pay' = ```
			
			CALCULATE(
			    SUMX(
			        VALUES(Salary[EmployeeID]), 
			        AVERAGE(Salary[BaseSalary])
			    ),
			    YEAR(Salary[EffectiveDate]) IN VALUES('DateTable'[Year])
			)
			
			
			```
		lineageTag: 455c44f1-a6de-4de9-b3c8-5fa80fd01659

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Bonus Per Employee' = ```
			

	measure 'Pay Equality Ratio Rolling 12 Months (%)' = ```
			
			DIVIDE( 
			    [Rolling 12 Months Salary for Females],[Rolling 12 Months Salary for Males],
			    0
			)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %

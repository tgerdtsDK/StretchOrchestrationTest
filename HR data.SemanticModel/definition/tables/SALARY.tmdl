		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rolling 12 Months Salary' = ```
			
			CALCULATE(
			    SUM(SALARY[BaseSalary]),
			    DATESINPERIOD(
			        'DateTable'[Date],
			        LASTDATE('DateTable'[Date]),
			        -12,
			        MONTH
			    ),
			    FILTER(
			        SALARY,
			        SALARY[EffectiveDate] <= LASTDATE('DateTable'[Date]) &&
			        SALARY[EffectiveDate] >= DATEADD(LASTDATE('DateTable'[Date]), -12, MONTH)
			    )
			)
			
			```
		lineageTag: a67cbb97-2ac7-461d-8c1c-e9f37d0ae073

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prev 12M' = ```
			
			CALCULATE(
			    SUM(SALARY[BaseSalary]),
			    DATESINPERIOD(
			        'DateTable'[Date],
			        DATEADD(LASTDATE('DateTable'[Date]), -12, MONTH),  // Shift the date back by 12 months
			        -12,
			        MONTH
			    ),
			    FILTER(
			        SALARY,
			        SALARY[EffectiveDate] <= DATEADD(LASTDATE('DateTable'[Date]), -12, MONTH) &&
			        SALARY[EffectiveDate] >= DATEADD(LASTDATE('DateTable'[Date]), -24, MONTH)  // Get the period from 24 to 12 months ago
			    )
			)
			
			```
		lineageTag: c9077605-b676-4d96-b6fa-e925a196a02d

		annotation PBI_FormatHint = {"isGeneralNumber":true}


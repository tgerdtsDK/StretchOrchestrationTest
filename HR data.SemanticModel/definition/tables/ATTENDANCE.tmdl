table ATTENDANCE
	lineageTag: 45214281-e236-4556-9afe-13232c368025

	measure 'Total Employees' = DISTINCTCOUNT('ATTENDANCE'[EmployeeID])
		formatString: 0
		lineageTag: b6166932-6419-49a3-9c89-8189777b702e

	measure 'Attendance Before Exit' = ```
			
			VAR ExitDate =
			    MAXX(
			        FILTER(ATTRITION, ATTRITION[EmployeeID] = SELECTEDVALUE(ATTENDANCE[EmployeeID])),
			        ATTRITION[TerminationDate]
			    )
			VAR DaysPhysicallyPresentBeforeExit =
			    CALCULATE(
			        COUNT(ATTENDANCE[Date]),
			        ATTENDANCE[Status] = "Present",
			        ATTENDANCE[Date] <= ExitDate
			    )
			VAR TotalDaysBeforeExit =
			    CALCULATE(
			        COUNT(ATTENDANCE[Date]),
			        ATTENDANCE[Date] <= ExitDate
			    )
			RETURN
			IF(
			    NOT(ISBLANK(ExitDate)),
			    DIVIDE(DaysPhysicallyPresentBeforeExit, TotalDaysBeforeExit, 0)
			)
			
			```
		lineageTag: 37094888-9d9f-4b95-988e-b05a9297061b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AverageWorkHours = ```
			AVERAGE(Attendance[WorkHours])
			
			```
		lineageTag: ce13d54b-d4d7-41bd-bfde-2cd1371cb194

		annotation PBI_FormatHint = {"isGeneralNumber":true}


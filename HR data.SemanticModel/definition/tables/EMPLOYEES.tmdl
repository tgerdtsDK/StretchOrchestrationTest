	column Tenure = ```
			
			VAR TermDate = LOOKUPVALUE(Attrition[TerminationDate], Attrition[EmployeeID], Employees[EmployeeID])
			VAR EndDate = IF(ISBLANK(TermDate), TODAY(), TermDate)
			RETURN DATEDIFF(EMPLOYEES[HireDate], EndDate, YEAR)
			
			```
		formatString: 0
		lineageTag: 48f0682d-083e-45fc-800e-bc69e926f70b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age Group' = ```
			
			SWITCH(
			    TRUE(),
			    EMPLOYEES[Age] >= 20 && EMPLOYEES[Age] < 30, "20-29",
			    EMPLOYEES[Age] >= 30 && EMPLOYEES[Age] < 40, "30-39",
			    EMPLOYEES[Age] >= 40 && EMPLOYEES[Age] < 50, "40-49",
			    EMPLOYEES[Age] >= 50 && EMPLOYEES[Age] < 60, "50-59",
			    EMPLOYEES[Age] >= 60, "60+"
			)
			
			```
		lineageTag: 4a3ec055-962e-4a8a-9d13-26040f71bf0d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FullName = ```
			Employees[FirstName] & " " & Employees[LastName]
			
			```
		lineageTag: c10cfded-b08b-4eb5-aaae-f4dd6bd52336
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


table EMPLOYEES
	lineageTag: ab8534ed-eb4c-4523-9079-fd822db5e32e

	measure 'New Hires' = ```
			
			IF(
			    ISFILTERED('DateTable'[Year]),
			    CALCULATE(
			        DISTINCTCOUNT(Employees[EmployeeID]),
			        YEAR(Employees[HireDate]) = MAX('DateTable'[Year])
			    ),
			    CALCULATE(
			        DISTINCTCOUNT(Employees[EmployeeID])
			    )
			)
			
			```
		formatString: 0
		lineageTag: 08de352e-01f7-4e72-bf5a-04171b521d7f

	measure 'Total Managers in Year' = ```
			
			VAR SelectedYear = SELECTEDVALUE('DateTable'[Year], YEAR(TODAY()))  -- Default to current year if none selected
			RETURN 
			CALCULATE(
			    COUNTROWS('Employees'),
			    'Employees'[JobTitle] = "Manager",
			    'Employees'[HireDate] <= DATE(SelectedYear, 12, 31), 
			    NOT (
			        'Attrition'[TerminationDate] < DATE(SelectedYear, 1, 1) && NOT ISBLANK('Attrition'[TerminationDate])
			    )
			)
			
			```
		formatString: 0
		lineageTag: e3ea1720-b852-47e8-aeed-235f5c79012c

	measure 'Average Tenure' = ```
			
			CALCULATE(
			    AVERAGE(Employees[Tenure]),
			    FILTER(
			        Employees,
			        Employees[EmployeeID] IN VALUES(Attendance[EmployeeID])
			    ),
			    VALUES('DateTable'[Year])
			)
			
			```
		lineageTag: 901f4e37-f47a-4b5e-b22f-a3b8ef2a4a32

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Age' = ```
			
			VAR SelectedYear = COALESCE(SELECTEDVALUE('DateTable'[Year]), MAX('DateTable'[Year]))
			RETURN 
			AVERAGEX(
			    Employees,
			    DATEDIFF(Employees[DateOfBirth], DATE(SelectedYear, 12, 31), YEAR)
			)
			
			
			```
		lineageTag: 9cfb4f8b-eea7-4f41-972a-02c7124461b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Males = ```
			
			CALCULATE(
			    DISTINCTCOUNT(ATTENDANCE[EmployeeID]), 
			    EMPLOYEES[Gender] = "M"
			)
			
			
			```
		formatString: 0
		lineageTag: d880db41-23b1-4e6e-9601-8d0780f7f4cb

	measure Females = ```
			
			CALCULATE(
			    DISTINCTCOUNT(ATTENDANCE[EmployeeID]), 
			    EMPLOYEES[Gender] = "F"
			)
			
			
			```
		formatString: 0
		lineageTag: 50649c99-a62a-436a-b500-c32690260646

	measure 'Males %' = ```
			DIVIDE([Males], ATTENDANCE[Total Employees], 0)
			
			```
		lineageTag: b40a2c70-79ae-4061-886c-53d17ed6fb19

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Females %' = ```
			DIVIDE([Females], ATTENDANCE[Total Employees], 0)
			
			```
		lineageTag: c2442db7-9fa3-4c34-aedb-d804b6ebf573

		annotation PBI_FormatHint = {"isGeneralNumber":true}

